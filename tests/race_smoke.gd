extends SceneTree
## CI regression: exercise monster selection, race startup, physics, item use and finish.
func _initialize() -> void:
 var watchdog = create_timer(70.0, true, false)
 watchdog.timeout.connect(func():
  push_error("Regression watchdog: test aborted before successful completion")
  quit(1)
 )
 call_deferred("_run_tests")

func _run_tests() -> void:
 var packed = load("res://scenes/Main.tscn")
 if packed == null:
  push_error("Main scene missing")
  quit(1)
  return
 var game = packed.instantiate()
 root.add_child(game)
 await process_frame
 assert(game.interface.selection_buttons.size() == 12, "12 selectable monster cars")
 assert(game.showroom != null and game.showroom.visible, "new 3D garage showroom")
 assert(game.interface.boost_bar != null, "new race HUD acceleration display")
 assert(game.circuit.premium_road != null, "fine-grain road surface and terrain")
 assert(game.circuit.course_art_v3 != null, "large world architecture art layer mounted")
 assert(game.circuit.course_art_v3.strip_count == 360, "real red/white roadside rumble strips")
 assert(game.circuit.course_art_v3.scene_instances >= 1500, "high-detail themed roadside props present")
 assert(game.circuit.visual_polish != null, "per-biome new visual finish")
 assert(game.circuit.visual_polish.decorated_count == 3150, "fine detailed vegetation and star fragments")
 assert(game.circuit.visual_polish.atmosphere_ready, "real atmosphere initialized")
 assert(game.circuit.map_index == 0, "starting circuit is Monster Festival")
 assert(game.circuit.visual_polish.sun.light_energy <= 1.2, "festival sunlight is comfortable for kids")
 assert(game.circuit.visual_polish.environment.adjustment_brightness < 0.95, "festival no longer clips pastel colors")
 assert(not game.circuit.visual_polish.environment.glow_enabled, "festival avoids overly intense full-screen bloom")
 assert(game.circuit.premium_road.deco_count >= 70, "curved neon gates and stadium spectators")
 assert(game.interface.settings != null, "settings screen")
 assert(game.interface.telemetry != null, "custom analog speed gauge present")
 assert(game.interface.map_buttons.size() == 4, "all four illustrated world selection cards present")
 assert(game.interface.map_buttons[0].get_child_count() >= 3, "map card contains unique illustrated poster and labels")
 assert(game.interface.pause_page != null, "pause screen")
 assert(game.circuit.themed_landmarks == 4, "four decorated track zones")
 assert(game.circuit.scenery_detail != null, "detailed world is mounted")
 assert(game.circuit.scenery_detail.landmark_count >= 75, "rich district buildings and track signs")
 assert(game.circuit.scenery_detail.plant_instances >= 800, "instanced grass and magical flowers")
 assert(game.audio.music_player.stream != null, "original music stream")
 assert(game.audio.cues.has("finish"), "race sound effects")
 game.interface._open_settings("menu")
 assert(game.interface.settings.visible, "settings can be opened")
 assert(game.interface.quality_buttons.size() == 4, "four real graphics modes")
 assert(game.interface.pace_buttons.size() == 5, "five speed choices including ultra slow")
 game.interface._select_pace(0)
 assert(game.pace_mode == 0 and is_equal_approx(game._pace_factor(),0.32), "ultra slow is 32 percent of original speed")
 game.interface._select_pace(4)
 assert(game.pace_mode == 4 and is_equal_approx(game._pace_factor(),1.0), "fast speed matches original pace")
 game.interface._select_pace(1)
 assert(game.pace_mode == 1 and is_equal_approx(game._pace_factor(),0.63), "default children's speed is 63 percent")
 var saved_settings=ConfigFile.new()
 assert(saved_settings.load("user://monsterkart_settings.cfg") == OK, "speed changes are persisted")
 assert(int(saved_settings.get_value("gameplay","pace_mode_v2",-1)) == 1, "last selected speed persists across launches")
 game.interface._select_quality(3)
 assert(game.graphics_quality == 3, "ultra quality reaches the renderer")
 assert(game.get_viewport().msaa_3d == Viewport.MSAA_8X, "ultra uses true 8x antialiasing")
 assert(game.circuit.visual_polish.decoration[0].multimesh.visible_instance_count == 1050, "ultra displays all foliage")
 game.interface._select_quality(2)
 assert(game.graphics_quality == 2, "premium graphical option reaches game controller")
 assert(game.get_viewport().msaa_3d == Viewport.MSAA_4X, "high mode actually enables four-sample MSAA")
 assert(game.circuit.visual_polish.level == 2, "high detail scene objects activated")
 assert(not game.circuit.visual_polish.environment.glow_enabled, "first map suppresses glare even at high quality")
 game.interface._select_quality(0)
 assert(game.get_viewport().msaa_3d == Viewport.MSAA_DISABLED, "battery mode disables 3D MSAA")
 assert(not game.circuit.visual_polish.environment.glow_enabled, "battery mode disables bloom")
 game.interface._select_quality(1)
 assert(game.get_viewport().msaa_3d == Viewport.MSAA_2X, "balanced mode has twice-sampled edges")
 game.interface._select_quality(3)
 assert(not game.circuit.visual_polish.environment.glow_enabled, "ultra graphics still safe on first map")
 game.interface._close_settings()
 assert(game.interface.menu.visible, "settings return to garage")
 print("[SMOKE] settings and core scene passed; inspect 12 high-res karts")
 for i in range(12):
  game._preview(i)
  assert(game.selected == i, "Monster selection must work")
  assert(game.display_kart.art_detail != null, "monster art component")
  assert(game.display_kart.art_detail.detail_count >= 40, "detailed car sculpting")
  assert(game.display_kart.chassis_detail != null, "custom sculpted curved bodywork")
  assert(game.display_kart.premium_finish != null and game.display_kart.premium_finish.details >= 75, "all 12 premium cars have detailed alloy rims, glass and eye highlights")
 assert(game.interface.map_buttons.size() == 4, "four map choices must render in garage")
 print("[SMOKE] kart sculpting passed; generate and inspect 4 racetracks")
 for map_index in range(4):
  print("[SMOKE] building racetrack ",map_index)
  game.interface._select_map(map_index)
  await process_frame
  assert(game.selected_map == map_index, "selection reaches game controller")
  assert(game.circuit.map_index == map_index, "correct track geometry selected")
  assert(game.circuit.centers.size() == 180, "full traversable circuit")
  assert(game.circuit.premium_road.road != null, "painted asphalt mesh")
  assert(game.circuit.visual_polish != null and game.circuit.visual_polish.level == game.graphics_quality, "art quality persists while switching course")
  assert(game.circuit.visual_polish.decoration.size() == 3, "per-biome batched fine details")
  assert(game.circuit.visual_polish.cloud_group != null, "high-quality sky landmark layer")
  if map_index == 0:
   assert(not game.circuit.visual_polish.environment.glow_enabled, "opening circuit has subdued glow")
  else:
   assert(game.circuit.visual_polish.environment.glow_enabled, "other maps retain vivid premium bloom")
  assert(game.circuit.course_art_v3.biome == map_index, "stage-specific centerpiece and structures rebuilt")
  assert(game.circuit.course_art_v3.landmark_count >= 95, "theme landmarks detailed rather than plain tracks")
  assert(game.circuit.course_art_v3.quality_level == game.graphics_quality, "stage art follows quality preference")
  assert(game.circuit.fences != null and game.circuit.fences.fence_panels >= 1000, "continuous 3D safety barriers around the entire course")
  assert(game.circuit.fences.post_count >= 100, "both sides have actual fence supports")
  for side in [-1.0, 1.0]:
   for at_index in [0, 24, 69, 115, 172]:
    var far_out: Vector3 = game.circuit.at(at_index, side * 26.0)
    var contact: Dictionary = game.circuit.constrain_position(far_out, 1.45)
    assert(bool(contact["collided"]), "both outer and inner fences prevent escape")
    var corrected: Vector3 = contact["position"]
    var safety: Dictionary = game.circuit.constrain_position(corrected, 1.45)
    assert(not bool(safety["collided"]), "fence correction brings car within the drivable corridor")
  assert(game.circuit.total_length > 250.0, "complete closed loop")
  if map_index == 0:
   assert(game.circuit.themed_landmarks == 4, "original monster park is retained")
  else:
   assert(game.circuit.alternate_detail != null, "new distinct biome artwork loaded")
   assert(game.circuit.alternate_detail.biome == map_index, "correct unique biome")
   assert(game.circuit.alternate_detail.landmark_count >= 24, "biome landmarks and billboards")
   assert(game.circuit.alternate_detail.scatter_count >= 800, "dense instanced decoration")
 print("[SMOKE] all 4 racetrack tests passed; simulate full race")
 game._start_race()
 assert(not game.showroom.visible, "showroom hidden while racing")
 assert(game.opponents.size() == 7, "seven AI opponents")
 var first_bot=game.opponents[0]
 var first_progress=float(first_bot["progress"])
 game.interface._select_pace(0)
 game._update_ai(0.10)
 var slow_delta=float(first_bot["progress"])-first_progress
 game.interface._select_pace(4)
 first_progress=float(first_bot["progress"])
 game._update_ai(0.10)
 var fast_delta=float(first_bot["progress"])-first_progress
 assert(fast_delta > slow_delta * 2.8, "all AI racers respond to the speed setting")
 game.interface._select_pace(1)
 assert(is_equal_approx(game._pace_factor(),0.48), "racing restores child-friendly default pace")
 assert(game.interface.telemetry != null and game.interface.telemetry.accent != Color.WHITE, "speedometer changes color for each world")
 assert(game.interface.race_minimap != null and game.interface.race_minimap.is_ready, "full circuit map initialized")
 assert(game.interface.race_minimap.mapped_points.size() == 181, "minimap displays entire closed track")
 assert(game.interface.race_minimap.racers.size() == 7, "minimap tracks each AI driver, plus player")
 assert(game.interface.map_title.text.find("ORBITAL") >= 0, "race map title matches selected track")
 assert(game.player != null, "playable monster car")
 assert(game.pickups.size() == 16, "collectible items")
 for i in range(250):
  game._physics_process(1.0 / 60.0)
 assert(game.race_state == "racing", "race countdown must finish")
 game._pause_race()
 assert(game.race_state == "paused" and game.interface.pause_page.visible, "pause from race")
 var paused_timer = game.race_time
 game._physics_process(1.0)
 assert(is_equal_approx(game.race_time, paused_timer), "pause freezes time")
 game.interface._open_settings("pause")
 assert(game.interface.settings.visible, "options from pause")
 game.interface._close_settings()
 assert(game.interface.pause_page.visible, "settings returns to pause")
 game._resume_race()
 assert(game.race_state == "racing" and game.interface.hud.visible, "resume race")
 game.interface.left_held = true
 game.interface.drift_held = true
 for i in range(95):
  game._physics_process(1.0 / 60.0)
 assert(game.speed > 4.0, "player auto accelerates")
 game.interface.drift_held = false
 game._physics_process(1.0 / 60.0)
 assert(game.boost_time > 0.0, "drifting must provide mini turbo")
 game.current_item = "SHIELD"
 game._use_item()
 assert(game.shield_time > 0.0, "shield item works")
 game.current_item = "TURBO"
 game._use_item()
 assert(game.boost_time > 2.0, "boost item works")
 game.current_item = "BANANA"
 game._use_item()
 assert(game.hazards.size() == 1, "hazard drops")
 # Drive the player directly toward the barrier and make sure physics prevents escape.
 game.player.position = game.circuit.at(43, 22.0) + Vector3(0, 0.26, 0)
 game.speed = 42.0
 var crashes = game.wall_hits
 game._physics_process(1.0 / 60.0)
 assert(game.wall_hits > crashes, "hitting a wall triggers actual contact")
 var fixed_contact: Dictionary = game.circuit.constrain_position(game.player.position, 1.45)
 assert(not bool(fixed_contact["collided"]), "player cannot pass the fence")
 assert(game.speed > 32.0, "wall contact preserves momentum and no longer stops the kart")
 var scrape_speed = game.speed
 game.player.position = game.circuit.at(43, 22.0) + Vector3(0, 0.26, 0)
 game._physics_process(1.0 / 60.0)
 assert(game.speed > scrape_speed - 1.0, "continued wall grinding must not repeatedly punish speed")
 var clipped: Dictionary = game.circuit.constrain_position(game.player.position, 1.45)
 assert(not bool(clipped["collided"]), "gentle wall slide still blocks escaping the circuit")
 assert(game.interface.race_minimap.racers.size() == 7, "all AI markers continue updating")
 game._finish()
 assert(game.race_state == "finished", "finish panel")
 game._return_to_menu()
 assert(game.race_state == "menu", "back to garage")
 assert(game.showroom.visible, "showroom restored on return")
 print("MONSTER KART SMOKE OK: five kids speed modes, immersive UI with painted track posters and speedometer, handcrafted 3D world landmarks, AI speed scaling, 4 circuits and full minimap")
 game.queue_free()
 quit(0)
